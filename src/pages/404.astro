---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="没有找到这个页面">
  <section class="not-found">
    <p class="error-code">404</p>
    <h1>没有这一页。</h1>
    <p>它可能被删除了，或者从未存在过。</p>
    <a class="text-link" href="/">回到首页 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
