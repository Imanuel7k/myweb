<figure class="ordinal-field" aria-label="从有限序列延伸至 ω 与 ω₁ 的抽象图形">
  <canvas aria-hidden="true"></canvas>
  <figcaption aria-hidden="true">
    <span>0</span>
    <span>1</span>
    <span>2</span>
    <span>…</span>
    <span>ω</span>
    <span>ω₁</span>
  </figcaption>
</figure>

<script>
  const fields = document.querySelectorAll<HTMLElement>(".ordinal-field");

  fields.forEach((field) => {
    const canvas = field.querySelector<HTMLCanvasElement>("canvas")!;
    if (!canvas) return;
    const context = canvas.getContext("2d")!;
    if (!context) return;

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    let width = 0;
    let height = 0;

    function palette() {
      const styles = getComputedStyle(document.documentElement);
      return {
        ink: styles.getPropertyValue("--ink").trim(),
        faint: styles.getPropertyValue("--ink-faint").trim(),
        accent: styles.getPropertyValue("--accent").trim(),
      };
    }

    function draw(time = 0) {
      const colors = palette();
      context.clearRect(0, 0, width, height);
      context.lineCap = "round";
      context.lineJoin = "round";

      const left = width * 0.045;
      const right = width * 0.955;
      const baseline = height * 0.78;
      const limit = width * 0.69;
      const omegaOne = width * 0.91;
      const drift = reducedMotion.matches ? 0 : Math.sin(time / 4200) * height * 0.008;

      context.strokeStyle = colors.ink;
      context.globalAlpha = 0.22;
      context.lineWidth = 1;
      context.beginPath();
      context.moveTo(left, baseline);
      context.lineTo(right, baseline);
      context.stroke();

      for (let index = 0; index < 38; index += 1) {
        const progress = index / 37;
        const compressed = 1 - Math.pow(1 - progress, 2.65);
        const x = left + (limit - left) * compressed;
        const tick = 5 + (index % 5 === 0 ? 9 : index % 2 === 0 ? 4 : 0);
        context.globalAlpha = 0.18 + progress * 0.28;
        context.beginPath();
        context.moveTo(x, baseline - tick);
        context.lineTo(x, baseline + tick);
        context.stroke();
      }

      context.globalAlpha = 0.12;
      for (let index = 0; index < 11; index += 1) {
        const spread = index / 10;
        const startY = height * (0.15 + spread * 0.49);
        const controlY = height * (0.03 + spread * 0.64) + drift * (spread - 0.5);
        context.beginPath();
        context.moveTo(left, startY);
        context.bezierCurveTo(
          width * (0.22 + spread * 0.04),
          controlY,
          width * (0.49 - spread * 0.03),
          height * (0.73 - spread * 0.23),
          limit,
          baseline,
        );
        context.stroke();
      }

      context.globalAlpha = 0.28;
      context.beginPath();
      context.arc(limit, baseline, Math.max(4, width * 0.006), 0, Math.PI * 2);
      context.stroke();

      context.globalAlpha = 0.14;
      context.beginPath();
      context.moveTo(limit, baseline);
      context.bezierCurveTo(width * 0.75, height * 0.34, width * 0.84, height * 0.34, omegaOne, baseline);
      context.stroke();

      context.globalAlpha = 0.1;
      for (let ring = 1; ring <= 3; ring += 1) {
        context.beginPath();
        context.ellipse(
          limit,
          baseline,
          width * 0.024 * ring,
          height * 0.045 * ring,
          -0.18,
          Math.PI * 1.08,
          Math.PI * 1.93,
        );
        context.stroke();
      }

      const travel = reducedMotion.matches ? 0.52 : (Math.sin(time / 3300) + 1) / 2;
      const pointX = limit + (omegaOne - limit) * travel;
      const pointY = baseline - Math.sin(Math.PI * travel) * height * 0.33;
      context.fillStyle = colors.accent;
      context.globalAlpha = 0.9;
      context.beginPath();
      context.arc(pointX, pointY, Math.max(2.2, width * 0.0035), 0, Math.PI * 2);
      context.fill();

      context.strokeStyle = colors.accent;
      context.globalAlpha = 0.72;
      context.beginPath();
      context.arc(omegaOne, baseline, Math.max(5, width * 0.008), 0, Math.PI * 2);
      context.stroke();

      context.globalAlpha = 1;
    }

    function resize() {
      const bounds = field.getBoundingClientRect();
      const ratio = Math.min(devicePixelRatio || 1, 2);
      width = Math.round(bounds.width);
      height = Math.round(bounds.height);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw(performance.now());
    }

    function animate(time: number) {
      draw(time);
      frame = requestAnimationFrame(animate);
    }

    const observer = new ResizeObserver(resize);
    observer.observe(field);
    const themeObserver = new MutationObserver(() => draw(performance.now()));
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    reducedMotion.addEventListener("change", () => {
      cancelAnimationFrame(frame);
      draw(performance.now());
      if (!reducedMotion.matches) frame = requestAnimationFrame(animate);
    });

    resize();
    if (!reducedMotion.matches) frame = requestAnimationFrame(animate);
  });
</script>
