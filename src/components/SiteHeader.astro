---
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "首页" },
  { href: "/posts/", label: "文章" },
  { href: "/about/", label: "关于" },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="ℵ₁ 首页">
    <span class="wordmark-symbol">ℵ<sub>1</sub></span>
    <span class="wordmark-text"><b>Aleph One</b></span>
  </a>
  <div class="header-actions">
    <nav class="site-nav" aria-label="主导航">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={item.href === "/" ? path === "/" ? "page" : undefined : path.startsWith(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a class="header-subscribe" href="/subscribe/">订阅</a>
    <button class="theme-toggle" type="button" aria-label="切换颜色主题" title="切换颜色主题">
      <span class="theme-light" aria-hidden="true">◐</span>
      <span class="theme-dark" aria-hidden="true">◑</span>
    </button>
  </div>
</header>

<script>
 document.addEventListener("astro:page-load", () => {
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

  button?.addEventListener("click", () => {
    const root = document.documentElement;
    const current = root.dataset.theme === "dark" ? "dark" : "light";
    const next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("theme", next);
  });

 });
</script>
